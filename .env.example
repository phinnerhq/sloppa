# Artifacts server
HOST=127.0.0.1
PORT=4100
PUBLIC_URL=http://127.0.0.1:4100
# Guards the dashboard, the HTTP API and the MCP endpoint
UPLOAD_TOKEN=dev-upload-token

# Serve the built SPA (bun run build) from the API server
STATIC_DIR=apps/web/dist

# SQLite index, plus the files themselves when S3 is off
DATA_DIR=.data

# Production: store files in an S3 bucket (RustFS, MinIO, AWS...) instead of DATA_DIR
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=artifacts
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Artifacts server
HOST=127.0.0.1
PORT=4100
PUBLIC_URL=http://127.0.0.1:4100
# The first user, created on boot. Unset these afterwards and change the password from the account menu;
# setting a new one resets it. Agents get tokens from the dashboard.
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=dev-password
# Behind a reverse proxy: rate-limit sign-ins by the X-Forwarded-For it sets
# TRUST_PROXY=true

# Serve the built SPA (pnpm build) from the API server
STATIC_DIR=apps/web/dist

# Accounts and the SQLite index, plus the files themselves when S3 is off
DATA_DIR=.data

# Production: store files in an S3 bucket (RustFS, MinIO, AWS...) instead of DATA_DIR
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=artifacts
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Previews (sloppa preview run): on the app's port, told apart by host, as subdomains of PREVIEW_ORIGIN
# PREVIEW_ORIGIN=http://preview.localhost:4100
# PREVIEW_SECRET=   # openssl rand -base64 32
# Guesses at unknown previews or passwords a client gets: a burst, then one per interval
# PREVIEW_MISS_BURST=20
# PREVIEW_MISS_EVERY=3 seconds

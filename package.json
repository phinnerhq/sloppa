{
  "name": "sloppa",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @sloppa/web dev",
    "dev:server": "go run -tags nodynamic ./cmd/sloppa serve",
    "build": "pnpm --filter @sloppa/web build && node scripts/embed-web.ts && go build -tags nodynamic -trimpath -o dist/ ./cmd/sloppa",
    "start": "go run -tags nodynamic ./cmd/sloppa serve",
    "test": "vitest run && go test -race ./...",
    "typecheck": "tsc -p .",
    "doodles": "node scripts/doodles.ts",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "lint": "oxlint && go vet ./...",
    "fmt": "oxfmt && gofmt -w cmd internal",
    "fmt:check": "oxfmt --check && node scripts/gofmt-check.ts",
    "check": "tsc -p . && oxlint && oxfmt --check && node scripts/gofmt-check.ts && go vet ./... && fallow --summary",
    "fallow": "fallow"
  },
  "devDependencies": {
    "@effect/tsgo": "0.53.0",
    "@phosphor-icons/core": "^2.1.1",
    "@types/node": "^26.6.5",
    "fallow": "^3.33.1",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.8.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.5.1"
}

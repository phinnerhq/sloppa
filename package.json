{
  "name": "sloppa-artifacts",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @sloppa/server --filter @sloppa/web dev",
    "build": "pnpm --filter @sloppa/web --filter @sloppa/server --filter @sloppa/cli build",
    "start": "node --env-file-if-exists=.env apps/server/src/main.ts",
    "test": "node --test --test-concurrency=1 --test-timeout=120000 \"apps/*/test/*.test.ts\"",
    "typecheck": "tsc -p .",
    "doodles": "node scripts/doodles.ts",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "tsc -p . && oxlint && oxfmt --check"
  },
  "dependencies": {
    "effect": "4.0.4"
  },
  "devDependencies": {
    "@effect/tsgo": "0.53.0",
    "@phosphor-icons/core": "^2.1.1",
    "@types/node": "^26.6.5",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.8.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.5.1"
}
